rules_version = '2';

// ============================================================
// Regras de segurança do Firestore — Bolão Flex (PRD seção 24)
// ------------------------------------------------------------
// Princípios:
//  - cálculos sensíveis (pontuação, rankings) só mudam via
//    Cloud Functions (Admin SDK ignora estas regras);
//  - palpites são imutáveis após o início do jogo;
//  - só membros veem bolões privados.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isMember(poolId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/poolMembers/$(poolId + '_' + request.auth.uid));
    }
    function poolData(poolId) {
      return get(/databases/$(database)/documents/pools/$(poolId)).data;
    }
    function isOwner(poolId) {
      return isSignedIn() && poolData(poolId).ownerId == request.auth.uid;
    }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isSystemAdmin == true;
    }

    // -------- Usuários --------
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isUser(uid);
      // O usuário edita o próprio perfil, mas não os campos de stats
      // (esses são atualizados pelo backend / batches controlados).
      allow update: if isUser(uid);
      allow delete: if false;
    }

    // -------- Competições e jogos --------
    // Qualquer logado lê. Escrita: admin do sistema (pelo painel do app)
    // ou backend/Cloud Functions (que ignoram estas regras).
    match /competitions/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    match /matches/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // -------- Bolões --------
    match /pools/{poolId} {
      // Qualquer usuário logado pode LER o documento do bolão. Isso é
      // necessário para entrar por código de convite (achar o bolão
      // antes de ser membro) e para listar públicos/oficiais. Os dados
      // sensíveis (palpites) continuam protegidos por regras próprias,
      // e só o dono pode EDITAR o bolão (abaixo).
      allow read: if isSignedIn();

      allow create: if isSignedIn() &&
        request.resource.data.ownerId == request.auth.uid;

      // O dono pode editar a configuração geral. Além disso, qualquer
      // usuário logado pode alterar SOMENTE o memberCount (ao entrar/sair
      // do bolão) — nada além desse campo.
      allow update: if isOwner(poolId) ||
        (isSignedIn() &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberCount']));
      allow delete: if isOwner(poolId);
    }

    // -------- Membros do bolão --------
    match /poolMembers/{memberId} {
      allow read: if isSignedIn();
      // O próprio usuário cria seu vínculo (entrar no bolão).
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      // Sair do bolão (atualizar status) — só o próprio.
      allow update: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
    }

    // -------- Palpites --------
    match /predictions/{predId} {
      allow read: if isMember(resource.data.poolId);
      // Só o dono do palpite cria/edita, e o palpite não pode já estar travado.
      allow create, update: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        isMember(request.resource.data.poolId);
      allow delete: if false; // palpites não são apagados
    }

    // -------- Palpites de longo prazo --------
    match /longTermPredictions/{id} {
      allow read: if isMember(resource.data.poolId);
      allow create, update: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // -------- Snapshots (gerados pelo backend) --------
    match /standingsSnapshots/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // -------- Chaveamentos (copa) --------
    // Membros leem; só o dono do bolão gera/edita o chaveamento.
    match /knockoutBrackets/{id} {
      allow read: if isMember(resource.data.poolId);
      allow create, update: if isSignedIn() &&
        isOwner(request.resource.data.poolId);
      allow delete: if isSignedIn() && isOwner(resource.data.poolId);
    }

    // -------- Feed do bolão (mural) --------
    match /feedPosts/{id} {
      allow read: if isMember(resource.data.poolId);
      // Só o dono do bolão publica avisos.
      allow create: if isSignedIn() &&
        request.resource.data.authorId == request.auth.uid &&
        isOwner(request.resource.data.poolId);
      allow update, delete: if isSignedIn() && isOwner(resource.data.poolId);
    }

    // -------- Notificações --------
    // O backend cria; o usuário lê e marca como lida.
    match /notifications/{id} {
      allow read, update: if isSignedIn() &&
        resource.data.userId == request.auth.uid;
      allow create, delete: if false;
    }
  }
}
