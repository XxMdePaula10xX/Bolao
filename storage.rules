rules_version = '2';

// Regras do Firebase Storage (avatares e capas de bolões).
service firebase.storage {
  match /b/{bucket}/o {
    // Avatares: cada usuário só escreve no próprio arquivo.
    match /avatars/{userId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Capas de bolões: qualquer logado lê; upload por usuários logados.
    match /covers/{poolId}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
