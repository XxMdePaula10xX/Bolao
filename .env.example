# ============================================================
#  Configuração do Firebase (versão web / Vite)
# ------------------------------------------------------------
#  1. Console do Firebase > Config. do projeto > Seus apps > Web
#  2. Copie os valores do firebaseConfig para cá
#  3. Renomeie este arquivo para  .env  (sem o .example)
#
#  O prefixo VITE_ é obrigatório para o Vite expor no app.
#  São chaves públicas do cliente (não são segredos perigosos).
# ============================================================
VITE_FIREBASE_API_KEY=cole_aqui
VITE_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=seu-projeto
VITE_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=cole_aqui
VITE_FIREBASE_APP_ID=cole_aqui
