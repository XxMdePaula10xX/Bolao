# ============================================================
# Configuração do Firebase
# ------------------------------------------------------------
# 1. Crie um projeto em https://console.firebase.google.com
# 2. Adicione um app "Web" (ícone </>) ao projeto
# 3. Copie os valores do objeto "firebaseConfig" para cá
# 4. Renomeie este arquivo para ".env" (sem o .example)
#
# OBS: O prefixo EXPO_PUBLIC_ é obrigatório para o Expo
# expor essas variáveis no app. Estes valores NÃO são
# segredos perigosos (são chaves públicas do cliente),
# mas mesmo assim o .env fica fora do Git por boa prática.
# ============================================================

EXPO_PUBLIC_FIREBASE_API_KEY=cole_aqui
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=seu-projeto
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=seu-projeto.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=cole_aqui
EXPO_PUBLIC_FIREBASE_APP_ID=cole_aqui
